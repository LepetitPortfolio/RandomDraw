<?xml version="1.0" encoding="utf-8"?>
<root xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Injection du FileProvider dans le AndroidManifest.xml généré -->
    <androidManifestUpdates>
        <addElements tag="application">
            <provider
                android:name="androidx.core.content.FileProvider"
                android:authorities="${applicationId}.fileprovider"
                android:exported="false"
                android:grantUriPermissions="true">
                <meta-data
                    android:name="android.support.FILE_PROVIDER_PATHS"
                    android:resource="@xml/file_paths" />
            </provider>
        </addElements>
    </androidManifestUpdates>

    <!-- Inclusion du fichier file_paths.xml dans les ressources -->
    <resourceCopies>
        <copyFile src="$S(PluginDir)/Build/Android/res/xml/file_paths.xml" dst="$S(BuildDir)/res/xml/file_paths.xml"/>
    </resourceCopies>

    <!-- Dépendance Gradle nécessaire pour androidx.core (FileProvider) -->
    <buildGradleAdditions>
        <insert>
            dependencies {
                implementation 'androidx.core:core:1.3.2'
            }
        </insert>
    </buildGradleAdditions>
</root>